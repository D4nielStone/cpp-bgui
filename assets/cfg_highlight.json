{
  "rules": [
    {
      "pattern": "^[[:space:]]*[#;].*",
      "color": "#6A9955"
    },
    {
      "pattern": "^\\[[^\\]]+\\]",
      "color": "#DCDCAA"
    },
    {
      "pattern": "^[[:space:]]*[^=:#;[:space:]]+[[:space:]]*=",
      "color": "#9CDCFE"
    },
    {
      "pattern": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "color": "#CE9178"
    },
    {
      "pattern": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "color": "#B5CEA8"
    }
  ]
}
