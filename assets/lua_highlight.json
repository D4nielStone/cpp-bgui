{
  "rules": [
    {
      "pattern": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "color": "#CE9178"
    },
    {
      "pattern": "--.*",
      "color": "#6A9955"
    },
    {
      "pattern": "\\b(and|break|do|else|elseif|end|false|for|function|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b",
      "color": "#569CD6"
    },
    {
      "pattern": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "color": "#DCDCAA"
    },
    {
      "pattern": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "color": "#B5CEA8"
    }
  ]
}
