
{
  "rules": [
    {
      "pattern": "--\\[(=*)\\[[\\s\\S]*?\\]\\1\\]",
      "color": "#6A9955"
    },
    {
      "pattern": "--@(?:property|class|type|param|return|field|generic|alias|diagnostic|enum|meta|module|overload|deprecated|see|cast)\\b",
      "color": "#C586C0"
    },
    {
      "pattern": "--[^\\r\\n]*",
      "color": "#6A9955"
    },
    {
      "pattern": "\\[(=*)\\[[\\s\\S]*?\\]\\1\\]",
      "color": "#CE9178"
    },
    {
      "pattern": "\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'",
      "color": "#CE9178"
    },
    {
      "pattern": "\\b(?:0[xX][0-9a-fA-F]+(?:\\.[0-9a-fA-F]*)?(?:[pP][+-]?[0-9]+)?|[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?|\\.[0-9]+(?:[eE][+-]?[0-9]+)?)\\b",
      "color": "#B5CEA8"
    },
    {
      "pattern": "\\b(?:true|false|nil)\\b",
      "color": "#569CD6"
    },
    {
      "pattern": "\\b(?:and|break|do|else|elseif|end|for|function|goto|if|in|local|not|or|repeat|return|then|until|while)\\b",
      "color": "#569CD6"
    },
    {
      "pattern": "\\b(?:self|_ENV|_G|_VERSION)\\b",
      "color": "#569CD6"
    },
    {
      "pattern": "\\b(?:GameObject|Globals|Debug|Input|Time|Vector2|Vector3|Vector4|Quaternion|Color|Math|Scene|Camera|Transform|Entity|Audio|Physics|Renderer|Material|Shader|Resource|Asset|Application)\\b",
      "color": "#4EC9B0"
    },
    {
      "pattern": "\\b(?:math|string|table|coroutine|utf8|io|os|debug|package)\\b",
      "color": "#4EC9B0"
    },
    {
      "pattern": "\\b(?:print|pairs|ipairs|next|type|tostring|tonumber|assert|error|pcall|xpcall|select|unpack|require|load|loadfile|dofile|collectgarbage|setmetatable|getmetatable|rawget|rawset|rawequal|rawlen)\\b",
      "color": "#DCDCAA"
    },
    {
      "pattern": "\\b(?:setup|update|draw|destroy|on_start|on_update|on_destroy|on_collision_enter|on_collision_exit|on_trigger_enter|on_trigger_exit)\\b(?=\\s*\\()",
      "color": "#DCDCAA"
    },
    {
      "pattern": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()",
      "color": "#DCDCAA"
    },
    {
      "pattern": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b",
      "color": "#9CDCFE"
    },
    {
      "pattern": "(?<=:)[A-Za-z_][A-Za-z0-9_]*\\b",
      "color": "#DCDCAA"
    },
    {
      "pattern": "\\b(?:properties|transform|position|rotation|scale|velocity|enabled|active|visible|parent|children|name|id|x|y|z|w|r|g|b|a|deltaTime|move_speed|mouse_sensitivity|postProcessShader)\\b",
      "color": "#9CDCFE"
    },
    {
      "pattern": "\\b[A-Z][A-Z0-9_]{2,}\\b",
      "color": "#4FC1FF"
    },
    {
      "pattern": "\\.\\.\\.|\\.\\.|==|~=|<=|>=|//|<<|>>|[+*/%^#=<>~&|\\-]",
      "color": "#D4D4D4"
    },
    {
      "pattern": "[{}\\[\\]()]",
      "color": "#FFD700"
    },
    {
      "pattern": "[,;:]",
      "color": "#D4D4D4"
    },
    {
      "pattern": "\\b(?:TODO|FIXME|HACK|NOTE|BUG|WARNING)\\b",
      "color": "#D7BA7D"
    }
  ]
}

