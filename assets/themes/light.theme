# =========================
# BASE (default)
# =========================
[base]
visual.background.normal = 0.98, 0.985, 0.98, 1.0
visual.text.normal       = 0.12, 0.16, 0.16, 1.0
visual.font              = default
visual.border.normal     = 0.76, 0.80, 0.78, 1.0


# =========================
# TYPES
# =========================

[type.linear]
visual.background.normal = 0.95, 0.965, 0.95, 1.0
visual.border.normal     = 0.84, 0.87, 0.85, 1.0
visual.visible           = false
layout.padding           = 5, 2


[type.window]
visual.background.normal = 0.99, 0.995, 0.99, 1.0
visual.border.normal     = 0.81, 0.85, 0.82, 1.0
visual.visible           = true
layout.padding           = 0, 0
layout.size              = 400, 300


[type.element]
visual.background.normal = 0.955, 0.97, 0.955, 1.0


# =========================
# BUTTON
# =========================

[type.button]
visual.background.normal  = 0.92, 0.945, 0.925, 1.0
visual.background.hover   = 0.86, 0.91, 0.88, 1.0
visual.background.pressed = 0.79, 0.87, 0.83, 1.0
visual.border.normal      = 0.72, 0.79, 0.75, 1.0
visual.border.radius      = 10
visual.border.size        = 1
layout.padding            = 5, 5, 5, 5
layout.mode               = stretch, wrap_content


# =========================
# INPUT AREA
# =========================

[type.inputarea]
visual.background.normal  = 0.965, 0.98, 0.965, 1.0
visual.background.focused = 0.91, 0.955, 0.94, 1.0
visual.background.hover   = 0.94, 0.965, 0.95, 1.0
visual.background.pressed = 0.89, 0.94, 0.92, 1.0
visual.border.normal      = 0.76, 0.82, 0.79, 1.0
visual.border.focused     = 0.18, 0.46, 0.43, 1.0
visual.border.radius      = 4
visual.border.size        = 1
layout.padding            = 0
layout.mode               = stretch, wrap_content


# =========================
# CHECKBOX
# =========================

[type.checkbox]
visual.background.normal = 0.95, 0.97, 0.955, 1.0
visual.background.hover  = 0.88, 0.93, 0.90, 1.0
visual.border.normal     = 0.69, 0.77, 0.73, 1.0
visual.border.radius     = 10
visual.border.size       = 1
layout.padding           = 2, 2
layout.mode              = stretch, wrap_content


# =========================
# TEXT
# =========================

[type.text]
visual.background.normal = 0.99, 0.995, 0.99, 1.0
visual.border.normal     = 0.99, 0.995, 0.99, 1.0
visual.text.normal       = 0.12, 0.16, 0.16, 1.0
visual.font              = default
layout.mode              = wrap_content, wrap_content
layout.align             = center


# =========================
# CLASSES
# =========================

[class.window-header]
layout.mode               = stretch, wrap_content
layout.padding            = 0, 0
visual.background.normal  = 0.92, 0.95, 0.93, 1.0
visual.border.normal      = 0.80, 0.85, 0.82, 1.0
visual.visible            = true


[class.window-button]
layout.mode              = wrap_content, wrap_content
layout.padding           = 0
layout.margin            = 0
visual.background.normal = 0.99, 0.995, 0.99, 1.0
visual.border.normal     = 0.99, 0.995, 0.99, 1.0


[class.inputarea-txt]
layout.mode = stretch, wrap_content
layout.align = start, start
layout.margin = 5, 5

[class.checkbox-box]
visual.background.pressed = 0.16, 0.45, 0.42, 1.0
visual.border.normal      = 0.69, 0.77, 0.73, 1.0
visual.border.radius      = 10
visual.border.size        = 2
layout.margin             = 5, 5
layout.limit_min          = 12, 12
layout.mode               = same, match_parent


[class.checkbox-txt]
layout.mode   = stretch, wrap_content
layout.align  = end
layout.margin = 1, 1


[class.window-label]
visual.background.normal = 0.99, 0.995, 0.99, 1.0
visual.border.normal     = 0.99, 0.995, 0.99, 1.0
layout.align             = center
layout.mode              = stretch, wrap_content


# =========================
# ACCENT CLASSES
# =========================

[class.primary]
visual.background.normal = 0.16, 0.45, 0.42, 1.0
visual.background.hover  = 0.12, 0.38, 0.36, 1.0


[class.danger]
visual.background.normal = 0.73, 0.25, 0.22, 1.0
visual.background.hover  = 0.65, 0.19, 0.17, 1.0