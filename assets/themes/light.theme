# =========================
# BASE
# =========================
[base]
visual.background.normal = 0.96, 0.97, 0.99, 1.0
visual.text.normal = 0.17, 0.20, 0.24, 1.0
visual.font = default
visual.border.normal = 0.81, 0.86, 0.90, 1.0

=========================
TYPES
=========================

[type.linear]
visual.background.normal = 0.96, 0.97, 0.99, 1.0
visual.border.normal = 0.84, 0.88, 0.92, 1.0
visual.visible = false
layout.padding = 2

[type.window]
visual.background.normal = 0.97, 0.98, 0.99, 1.0
visual.border.normal = 0.83, 0.87, 0.90, 1.0
visual.border.radius = 8
visual.visible = true
layout.padding = 3, 3
layout.size = 400, 300

[type.element]
visual.background.normal = 0.97, 0.98, 0.99, 1.0

[type.tree]
visual.visible = false
layout.mode = match_parent, wrap_content
layout.padding = 0

[type.modal]
visual.background.normal = 0.0, 0.0, 0.0, 0.65
visual.border.normal = 0.0
layout.mode = match_parent, match_parent
layout.align = center, center

[class.modal-panel]
visual.background.normal = 0.99, 0.995, 1.0, 1.0
visual.border.normal = 0.82, 0.86, 0.90, 1.0
visual.border.size = 1
visual.border.radius = 4
visual.visible = true
layout.mode = wrap_content, wrap_content
layout.padding = 16, 16

[class.modal-content]
layout.mode = wrap_content, wrap_content

[class.modal-actions]
layout.mode = stretch, wrap_content
layout.align = end, start

[class.modal-confirm]
layout.mode = wrap_content, wrap_content

[class.modal-text]
layout.align = start, start

[class.tree-element-label]
visual.background.normal = 0.0
visual.background.hover = 0.91, 0.93, 0.97, 1.0
visual.background.pressed = 0.85, 0.88, 0.93, 1.0
visual.border.normal = 0.0
visual.border.radius = 0
visual.border.size = 0
layout.mode = match_parent, wrap_content
layout.padding = 4, 1

[class.tree-element-label-text]
visual.background.normal = 0.0
visual.border.normal = 0.0
visual.text.normal = 0.20, 0.23, 0.28, 1.0
layout.mode = stretch, wrap_content
layout.align = start, center
layout.padding = 2, 0

[class.tree-element-children]
visual.background.normal = 0.0
visual.border.normal = 0.0

=========================
BUTTON
=========================

[type.button]
visual.background.normal = 0.93, 0.95, 0.98, 1.0
visual.background.hover = 0.88, 0.91, 0.96, 1.0
visual.background.pressed = 0.82, 0.87, 0.92, 1.0
visual.border.normal = 0.71, 0.78, 0.84, 1.0
visual.border.radius = 3
visual.border.size = 1
layout.padding = 0, 0
layout.mode = stretch, wrap_content

=========================
INPUT BOX
=========================

[type.combobox]
visual.background.normal = 0.93, 0.95, 0.98, 1.0
visual.background.hover = 0.88, 0.91, 0.96, 1.0
visual.background.pressed = 0.82, 0.87, 0.92, 1.0
visual.border.normal = 0.71, 0.78, 0.84, 1.0
visual.border.radius = 3
visual.border.size = 1
layout.padding = 6, 2
layout.mode = stretch, wrap_content

[class.combo-box-label]
layout.mode = stretch, wrap_content
layout.align = start, center

[class.combo-box-indicator]
layout.mode = wrap_content, wrap_content
layout.padding = 6, 0

[class.combo-box-popup]
visual.background.normal = 0.99, 0.995, 1.0, 1.0
visual.border.normal = 0.71, 0.78, 0.84, 1.0
visual.border.radius = 3
visual.border.size = 1
visual.visible = true
layout.mode = match_parent, wrap_content
layout.padding = 2

[class.combo-box-option]
visual.background.normal = 0.99, 0.995, 1.0, 1.0
visual.background.hover = 0.89, 0.92, 0.96, 1.0
visual.border.normal = 0.99, 0.995, 1.0, 1.0
visual.border.radius = 0
layout.padding = 6, 2
layout.mode = match_parent, wrap_content

[type.inputarea]
visual.background.normal = 0.98, 0.99, 1.0, 1.0
visual.background.focused = 0.96, 0.98, 1.0, 1.0
visual.background.hover = 0.97, 0.98, 1.0, 1.0
visual.background.pressed = 0.94, 0.96, 0.99, 1.0
visual.border.normal = 0.73, 0.80, 0.87, 1.0
visual.border.focused = 0.00, 0.47, 0.80, 1.0
visual.border.radius = 2
visual.border.size = 1
layout.padding = 0, 0
layout.mode = stretch, wrap_content

=========================
CHECKBOX
=========================

[type.checkbox]
visual.background.normal = 0.96, 0.98, 1.0, 1.0
visual.background.hover = 0.90, 0.94, 0.98, 1.0
visual.border.normal = 0.70, 0.77, 0.83, 1.0
visual.border.radius = 2
visual.border.size = 1
layout.padding = 2, 2
layout.mode = stretch, wrap_content

=========================
SLIDER AND PROGRESS BAR
=========================

[type.slider]
visual.background.normal = 0.82, 0.86, 0.90, 1.0
visual.background.hover = 0.78, 0.83, 0.88, 1.0
visual.border.normal = 0.00, 0.47, 0.80, 1.0
visual.border.hover = 0.10, 0.55, 0.88, 1.0
layout.mode = match_parent, pixel
layout.size = 200, 24

[type.progressbar]
visual.background.normal = 0.82, 0.86, 0.90, 1.0
visual.border.normal = 0.00, 0.47, 0.80, 1.0
layout.mode = match_parent, pixel
layout.size = 200, 14

=========================
TEXT
=========================

[type.text]
visual.background.normal = 0.0
visual.border.normal = 0.0
visual.text.normal = 0.17, 0.20, 0.24, 1.0
visual.font = default
layout.mode = wrap_content, wrap_content
layout.align = center

=========================
MENU BAR
=========================

[type.menubar]
visual.border.normal = 0
layout.padding = 4

=========================
CLASSES
=========================

[class.dock-tab]
layout.mode = stretch, wrap_content

[class.window-header]
layout.mode = stretch, wrap_content
layout.padding = 0, 0
visual.visible = false

[class.window-button]
layout.mode = wrap_content, wrap_content
layout.padding = 0, 0
layout.margin = 0
visual.background.normal = 0.0
visual.border.normal = 0.0

[class.inputarea-txt]
layout.mode = stretch, wrap_content
layout.align = start, start
layout.margin = 5, 5

[class.checkbox-box]
visual.background.normal = 0.99, 1.0, 1.0, 1.0
visual.background.hover = 0.96, 0.98, 1.0, 1.0
visual.background.pressed = 0.60, 0.75, 0.95, 1.0
visual.border.normal = 0.72, 0.78, 0.84, 1.0
visual.border.radius = 2
visual.border.size = 1
layout.margin = 5, 5
layout.limit_min = 12, 12
layout.mode = pixel, pixel
layout.size = 10, 10

[class.checkbox-txt]
layout.mode = stretch, wrap_content
layout.align = start, center
layout.margin = 1, 1

[class.window-label]
visual.background.normal = 0.0
visual.border.normal = 0.0
layout.align = center
layout.mode = stretch, wrap_content

[class.resize-handle]
visual.visible = false

[class.inputbox-label]
layout.mode = stretch, stretch;
layout.align = start, center;

=========================
ACCENT
=========================

[class.primary]
visual.background.normal = 0.00, 0.47, 0.80, 1.0
visual.background.hover = 0.10, 0.55, 0.88, 1.0

=========================
DANGER
=========================

[class.danger]
visual.background.normal = 0.75, 0.23, 0.23, 1.0
visual.background.hover = 0.88, 0.30, 0.30, 1.0
