=========================
SLIDER AND PROGRESS BAR
=========================

[type.slider]
visual.background.normal = 0.22, 0.22, 0.22, 1.0
visual.background.hover = 0.25, 0.25, 0.25, 1.0
visual.border.normal = 0.00, 0.47, 0.80, 1.0
visual.border.hover = 0.10, 0.55, 0.88, 1.0
layout.mode = match_parent, pixel
layout.size = 200, 24

[type.progressbar]
visual.background.normal = 0.22, 0.22, 0.22, 1.0
visual.border.normal = 0.00, 0.47, 0.80, 1.0
layout.mode = match_parent, pixel
layout.size = 200, 14

=========================
TEXT
=========================

[type.text]
visual.background.normal = 0.0
visual.border.normal = 0.0
visual.text.normal = 0.85, 0.85, 0.85, 1.0
visual.font = default

layout.mode = wrap_content, wrap_content
layout.align = center


=========================
MENU BAR
=========================

[type.menubar]
visual.border.normal = 0

layout.padding = 4

=========================
CLASSES
=========================

[class.dock-tab]
layout.mode = stretch, wrap_content

[class.window-header]
layout.mode = stretch, wrap_content
layout.padding = 0, 0
visual.visible = false

[class.window-button]
layout.mode = wrap_content, wrap_content
layout.padding = 0, 0
layout.margin = 0

visual.background.normal = 0.0
visual.border.normal = 0.0

[class.inputarea-txt]
layout.mode = stretch, wrap_content
layout.align = start, start
layout.margin = 5, 5

