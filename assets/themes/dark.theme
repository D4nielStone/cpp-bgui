=========================
BASE
=========================

[base]
visual.background.normal = 0.10, 0.10, 0.10, 1.0
visual.text.normal = 0.85, 0.85, 0.85, 1.0
visual.font = default
visual.border.normal = 0.13, 0.13, 0.13, 1.0

=========================
TYPES
=========================

[type.linear]
visual.background.normal = 0.10, 0.10, 0.10, 1.0
visual.border.normal = 0.12, 0.12, 0.12, 1.0
visual.visible = false
layout.padding = 2

[type.window]

Painel padrão mais escuro

visual.background.normal = 0.094, 0.094, 0.094, 1.0
visual.border.normal = 0.13, 0.13, 0.13, 1.0
visual.border.radius = 8
visual.visible = true
layout.padding = 3, 3
layout.size = 400, 300

[type.element]
visual.background.normal = 0.094, 0.094, 0.094, 1.0

[type.tree]
visual.visible = false
layout.mode = match_parent, wrap_content
layout.padding = 0

[type.modal]
visual.background.normal = 0.0, 0.0, 0.0, 0.65
visual.border.normal = 0.0
layout.mode = match_parent, match_parent
layout.align = center, center

[class.modal-panel]
visual.background.normal = 0.12, 0.12, 0.12, 1.0
visual.border.normal = 0.32, 0.32, 0.32, 1.0
visual.border.size = 1
visual.border.radius = 4
visual.visible = true
layout.mode = wrap_content, wrap_content
layout.padding = 16, 16

[class.modal-content]
layout.mode = wrap_content, wrap_content

[class.modal-actions]
layout.mode = stretch, wrap_content
layout.align = end, start

[class.modal-confirm]
layout.mode = wrap_content, wrap_content

[class.modal-text]
layout.align = start, start

[class.tree-element-label]
visual.background.normal = 0.0
visual.background.hover = 0.165, 0.176, 0.18, 1.0
visual.background.pressed = 0.216, 0.216, 0.239, 1.0
visual.border.normal = 0.0
visual.border.radius = 0
visual.border.size = 0
layout.mode = match_parent, wrap_content
layout.padding = 4, 1

[class.tree-element-label-text]
visual.background.normal = 0.0
visual.border.normal = 0.0
visual.text.normal = 0.8, 0.8, 0.8, 1.0
layout.mode = stretch, wrap_content
layout.align = start, center
layout.padding = 2, 0

[class.tree-element-children]
visual.background.normal = 0.0
visual.border.normal = 0.0

